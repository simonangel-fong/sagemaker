project    = "sagemaker-notebook"
env        = "dev"
aws_region = "ca-central-1"

notebook_instance_type = "ml.t3.medium"
notebook_volume_size   = 5

git_repository_url = "https://github.com/owner/repo.git"
git_branch         = "master"

vpc_id            = "vpc-xxxxxxxx"
public_subnet_ids = ["subnet-xxxxxxxx"]
